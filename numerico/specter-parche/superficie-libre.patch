+!***********************************************************************
+      SUBROUTINE fs_dwz_trace(planfc,vx,vy,t)
+!-----------------------------------------------------------------------
+!  dw/dz at z=Lz, from incompressibility: dw/dz = -i (kx vx + ky vy). It
+!  holds to FC-continuation accuracy (the harmonic part of the projection is
+!  continued with FC-Gram, so the spectral divergence is not exactly zero),
+!  which is the accuracy of the rest of the scheme.
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+      USE kes
+      USE var
+
+      IMPLICIT NONE
+
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(planfc%z%n,planfc%y%n,ista:iend) :: vx,vy
+      COMPLEX(KIND=GP),INTENT(OUT),DIMENSION(planfc%y%n,ista:iend)           :: t
+
+      INTEGER :: ind,i,j,k
+
+      DO i = ista,iend
+         DO j = 1,planfc%y%n
+            DO k = 1,planfc%z%n
+               fs_work(k,j,i) = -im*(kx(i)*vx(k,j,i) + ky(j)*vy(k,j,i))
+            ENDDO
+         ENDDO
+      ENDDO
+      CALL fftp1d_complex_to_real_z(planfc,fs_work,MPI_COMM_WORLD)
+      ind = planfc%z%n - planfc%z%c
+      DO i = ista,iend
+         DO j = 1,planfc%y%n
+            t(j,i) = fs_work(ind,j,i)/real(planfc%z%n, kind=GP)
+         ENDDO
+      ENDDO
+
+      RETURN
+      END SUBROUTINE fs_dwz_trace
+
+!***********************************************************************
+      SUBROUTINE v_fs_init(planbc,planfc,vx,vy,vz,pr,nu,dt,stat,dir,ext)
+!-----------------------------------------------------------------------
+!  Initializes the deformable free surface, once the initial velocity is
+!  known. Does nothing unless z=Lz is 'freesurface'.
+!   - eta: A cos(kx0 x + ky0 y) for a new run, or read from
+!     dir/fs_eta.ext.dat when restarting (stat > 0).
+!   - B_k, the response of w(Lz) to the surface velocity used in the
+!     stress datum, by running the surface pass on a zero field.
+!   - The surface traces of the initial velocity.
+!   - For a new run, pr is set to dt times the harmonic pressure that the
+!     initial surface imposes (exactly the initial pressure when the fluid
+!     starts at rest without forcing), instead of zero.
+!  ARGUMENTS:
+!    vi   : initial velocity, (kz,ky,kx). [IN]
+!    pr   : pressure potential, (z,ky,kx). [INOUT]
+!    nu   : kinematic viscosity. [IN]
+!    dt   : time step. [IN]
+!    stat : 0 for a new run, number of the restart file otherwise. [IN]
+!    dir  : input directory. [IN]
+!    ext  : extension of the restart files. [IN]
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+      USE grid
+      USE kes
+      USE var
+
+      IMPLICIT NONE
+
+      TYPE(BCPLAN), INTENT(IN)  :: planbc
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(nz,ny,ista:iend)    :: vx,vy,vz
+      COMPLEX(KIND=GP),INTENT(INOUT),DIMENSION(nz,ny,ista:iend) :: pr
+      REAL(KIND=GP), INTENT(IN)    :: nu,dt
+      INTEGER, INTENT(IN)          :: stat
+      CHARACTER(len=*), INTENT(IN) :: dir,ext
+
+      COMPLEX(KIND=GP), ALLOCATABLE, DIMENSION(:,:,:) :: dd
+      COMPLEX(KIND=GP), DIMENSION(ny,ista:iend)       :: zero,one
+      COMPLEX(KIND=GP), DIMENSION(2,ny,ista:iend)     :: bc
+      REAL(KIND=GP), DIMENSION(2) :: loc,glo
+      REAL(KIND=GP) :: amp
+      INTEGER       :: i0,j0,i,j,k
+
+      IF ( planbc%bczend .ne. 2 ) RETURN
+
+      ALLOCATE( fs_eta(ny,ista:iend), fs_eta0(ny,ista:iend) )
+      ALLOCATE( fs_wtop(ny,ista:iend), fs_dwz(ny,ista:iend), fs_bk(ny,ista:iend) )
+      ALLOCATE( fs_s1(nz,ny,ista:iend), fs_s2(nz,ny,ista:iend) )
+      ALLOCATE( fs_s3(nz,ny,ista:iend), fs_work(nz,ny,ista:iend) )
+      ALLOCATE( dd(nz,ny,ista:iend) )
+      fs_nu = nu
+      fs_dt = dt
+
+      ! Elevation
+      fs_eta = 0.0_GP
+      IF ( stat .eq. 0 ) THEN
+         i0 = fs_kx0 + 1
+         IF ( fs_ky0 .ge. 0 ) THEN
+            j0 = fs_ky0 + 1
+         ELSE
+            j0 = ny + fs_ky0 + 1
+         ENDIF
+         ! Nyquist modes are excluded: their coefficient is its own
+         ! conjugate and the A/2 split below does not apply
+         IF ( i0 .gt. nx/2 .OR. j0 .lt. 1 .OR. j0 .gt. ny .OR. &
+              j0 .eq. ny/2+1 ) THEN
+            IF ( myrank .eq. 0 ) PRINT*, "[ERROR] fskx, fsky out of range ", &
+                "(|fskx| < nx/2 and |fsky| < ny/2 are required)."
+            CALL MPI_ABORT(MPI_COMM_WORLD,1,ierr)
+         ENDIF
+         ! A cos(k0.x) has coefficient A/2 at +k0 and -k0 (A for k0=0). For
+         ! kx0 > 0 the -k0 mode is implicit; for kx0 = 0 both are stored.
+         amp = fs_amp*real(nx,kind=GP)*real(ny,kind=GP)
+         IF ( i0 .ge. ista .AND. i0 .le. iend ) THEN
+            IF ( i0 .eq. 1 .AND. j0 .eq. 1 ) THEN
+               fs_eta(1,1) = amp
+            ELSE
+               fs_eta(j0,i0) = amp/2
+               IF ( i0 .eq. 1 ) fs_eta(ny-j0+2,1) = amp/2
+            ENDIF
+         ENDIF
+      ELSE
+         CALL fs_read(dir,ext)
+      ENDIF
+      fs_eta0 = fs_eta
+
+      ! B_k: the surface pass on a zero field with W = 1 in every mode
+      fs_s1 = 0.0_GP; fs_s2 = 0.0_GP; fs_s3 = 0.0_GP
+      zero = 0.0_GP
+      one  = 1.0_GP
+      CALL fs_top_pass(planbc,planfc,fs_s1,fs_s2,fs_s3,dd,zero,zero,one)
+      CALL fs_trace(planfc,fs_s3,fs_bk)
+      loc(1) = maxval(abs(fs_bk))
+      CALL MPI_ALLREDUCE(loc,glo,1,GC_REAL,MPI_MAX,MPI_COMM_WORLD,ierr)
+      IF ( glo(1) .ge. 0.9_GP ) THEN
+         IF ( myrank .eq. 0 ) PRINT*, "[ERROR] free surface coupling ", &
+             "coefficient too close to 1: max|B_k| = ", glo(1)
+         CALL MPI_ABORT(MPI_COMM_WORLD,1,ierr)
+      ENDIF
+      IF ( myrank .eq. 0 ) PRINT*, "[INFO] freesurface: g = ", fs_grav, &
+          " sigma/rho = ", fs_tens, " max|B_k| = ", glo(1)
+
+      ! Traces of the initial velocity
+      CALL fs_trace(planfc,vz,fs_wtop)
+      CALL fs_dwz_trace(planfc,vx,vy,fs_dwz)
+
+      ! Initial pressure potential, as after an o=1 substage: d = dt p
+      IF ( stat .eq. 0 ) THEN
+         DO i = ista,iend
+            DO j = 1,ny
+               bc(1,j,i) = 0.0_GP
+               bc(2,j,i) = dt*( (fs_grav + fs_tens*khom(j,i)**2)*fs_eta(j,i) &
+                                + 2*fs_nu*fs_dwz(j,i) )
+            ENDDO
+         ENDDO
+         CALL laplace_z(bc,dd,fs_work,1,0)
+         DO i = ista,iend
+            DO j = 1,ny
+               DO k = 1,nz
+                  pr(k,j,i) = dd(k,j,i)
+               ENDDO
+            ENDDO
+         ENDDO
+      ENDIF
+
+      DEALLOCATE( dd )
+      fs_ready = .TRUE.
+
+      RETURN
+      END SUBROUTINE v_fs_init
+
+!***********************************************************************
+      SUBROUTINE fs_read(dir,ext)
+!-----------------------------------------------------------------------
+!  Reads the elevation, in the (ky,kx) domain, from dir/fs_eta.ext.dat
+!  (unformatted stream, the full ny x (nx/2+1) complex array).
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE grid
+
+      IMPLICIT NONE
+
+      CHARACTER(len=*), INTENT(IN) :: dir,ext
+      COMPLEX(KIND=GP), ALLOCATABLE, DIMENSION(:,:) :: full
+      INTEGER :: ios
+
+      ALLOCATE( full(ny,nx/2+1) )
+      IF ( myrank .eq. 0 ) THEN
+         OPEN(1,file=trim(dir)//'/fs_eta.'//trim(ext)//'.dat', &
+              form='unformatted',access='stream',status='old', &
+              action='read',iostat=ios)
+         IF ( ios .ne. 0 ) THEN
+            PRINT*, "[ERROR] cannot read ", trim(dir)//'/fs_eta.'//trim(ext)//'.dat'
+            CALL MPI_ABORT(MPI_COMM_WORLD,1,ierr)
+         ENDIF
+         READ(1) full
+         CLOSE(1)
+      ENDIF
+      CALL MPI_BCAST(full,ny*(nx/2+1),GC_COMPLEX,0,MPI_COMM_WORLD,ierr)
+      fs_eta(:,ista:iend) = full(:,ista:iend)
+      DEALLOCATE( full )
+
+      RETURN
+      END SUBROUTINE fs_read
+
+!***********************************************************************
+      SUBROUTINE v_fs_output(planbc,dir,ext)
+!-----------------------------------------------------------------------
+!  Writes the elevation to dir/fs_eta.ext.dat, in the format fs_read reads
+!  back: the (ky,kx) coefficients with the nx*ny normalization. Does
+!  nothing unless z=Lz is 'freesurface'.
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE grid
+
+      IMPLICIT NONE
+
+      TYPE(BCPLAN), INTENT(IN)     :: planbc
+      CHARACTER(len=*), INTENT(IN) :: dir,ext
+      COMPLEX(KIND=GP), ALLOCATABLE, DIMENSION(:,:) :: full,part
+
+      IF ( planbc%bczend .ne. 2 ) RETURN
+      ALLOCATE( full(ny,nx/2+1), part(ny,nx/2+1) )
+      part = 0.0_GP
+      part(:,ista:iend) = fs_eta(:,ista:iend)
+      CALL MPI_REDUCE(part,full,ny*(nx/2+1),GC_COMPLEX,MPI_SUM,0, &
+                      MPI_COMM_WORLD,ierr)
+      IF ( myrank .eq. 0 ) THEN
+         OPEN(1,file=trim(dir)//'/fs_eta.'//trim(ext)//'.dat', &
+              form='unformatted',access='stream',status='replace', &
+              action='write')
+         WRITE(1) full
+         CLOSE(1)
+      ENDIF
+      DEALLOCATE( full,part )
+
+      RETURN
+      END SUBROUTINE v_fs_output
+
+!***********************************************************************
+      SUBROUTINE fs_diagnostic(planfc,a,b,c,t,dt,wallstress,wbot)
+!-----------------------------------------------------------------------
+!  Writes 'freesurface_diagnostic.txt' (format frozen in
+!  verificacion/intent_fase5.txt):
+!    t, Re(eta_k0), Im(eta_k0), <eta>, rms(eta), <|tau_t|^2>|z=Lz,
+!    <|d(v_t)/dz|^2>|z=0, <|v_n|^2>|z=0, coupling mismatch,
+!  with eta_k0 normalized so that eta = A cos(k0.x) gives A, and
+!  tau_t = d(v_t)/dz + grad_t(v_z) the FULL tangential stress.
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+      USE grid
+      USE kes
+      USE var
+
+      IMPLICIT NONE
+
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP), INTENT(IN), DIMENSION(nz,ny,ista:iend) :: a,b,c
+      REAL(KIND=GP), INTENT(IN)        :: dt
+      INTEGER, INTENT(IN)              :: t
+      DOUBLE PRECISION, INTENT(IN)     :: wallstress,wbot
+
+      COMPLEX(KIND=GP), ALLOCATABLE, DIMENSION(:,:,:) :: D1,D2
+      DOUBLE PRECISION :: bot,top,loc(4),glo(4),fac
+      INTEGER          :: i,j,k,i0,j0
+
+      ALLOCATE( D1(nz,ny,ista:iend), D2(nz,ny,ista:iend) )
+      CALL derivk(a,D1,3)
+      CALL derivk(b,D2,3)
+      DO i = ista,iend
+         DO j = 1,ny
+            DO k = 1,nz
+               D1(k,j,i) = D1(k,j,i) + im*kx(i)*c(k,j,i)
+               D2(k,j,i) = D2(k,j,i) + im*ky(j)*c(k,j,i)
+            ENDDO
+         ENDDO
+      ENDDO
+      CALL bouncheck_z(planfc,bot,top,D1,D2)
+      DEALLOCATE( D1,D2 )
+
+      i0 = fs_kx0 + 1
+      IF ( fs_ky0 .ge. 0 ) THEN
+         j0 = fs_ky0 + 1
+      ELSE
+         j0 = ny + fs_ky0 + 1
+      ENDIF
+      loc = 0d0
+      IF ( i0 .ge. ista .AND. i0 .le. iend .AND. j0 .ge. 1 .AND. j0 .le. ny ) THEN
+         loc(1) = real(fs_eta(j0,i0), kind=GP)
+         loc(2) = aimag(fs_eta(j0,i0))
+      ENDIF
+      DO i = ista,iend
+         DO j = 1,ny
+            ! kx = 0 and the kx Nyquist column are not duplicated
+            IF ( i .eq. 1 .OR. i .eq. nx/2+1 ) THEN
+               loc(4) = loc(4) + abs(fs_eta(j,i))**2
+            ELSE
+               loc(4) = loc(4) + 2*abs(fs_eta(j,i))**2
+            ENDIF
+         ENDDO
+      ENDDO
+      IF ( ista .eq. 1 ) loc(3) = real(fs_eta(1,1), kind=GP)
+      CALL MPI_REDUCE(loc,glo,4,MPI_DOUBLE_PRECISION,MPI_SUM,0, &
+                      MPI_COMM_WORLD,ierr)
+
+      IF ( myrank .eq. 0 ) THEN
+         fac = 1d0/(dble(nx)*dble(ny))
+         IF ( .NOT. (i0 .eq. 1 .AND. j0 .eq. 1) ) THEN
+            glo(1:2) = 2*glo(1:2)
+         ENDIF
+         OPEN(1,file='freesurface_diagnostic.txt',position='append')
+30          FORMAT( 1P 9E23.15 )
+            WRITE(1,30) (t-1)*dt, glo(1)*fac, glo(2)*fac, glo(3)*fac, &
+                        sqrt(glo(4))*fac, top, wallstress, wbot,      &
+                        dble(fs_mismatch)
+         CLOSE(1)
+      ENDIF
+
+      RETURN
+      END SUBROUTINE fs_diagnostic
+
