+      SUBROUTINE sol_project_fs(a,b,c,d,dtop)
+!-----------------------------------------------------------------------
+!    Projection for the deformable free surface. Same as sol_project, but
+!   with a different boundary condition on each face, which the single
+!   bctarget of sol_project cannot express:
+!     z=0  : the normal component c vanishes after projection (Neumann
+!            problem for the potential, exactly as for a rigid wall);
+!     z=Lz : the potential itself takes the value dtop (inhomogeneous
+!            Dirichlet), which is how the normal stress balance of the
+!            surface enters the scheme.
+!   The potential d = (dt/o)*p is returned in the (z,ky,kx) domain, as in
+!   sol_project, so that it can be stored in pr.
+!
+! Parameters
+!     a, b, c  : x,y,z components of v, respectively (kz,ky,kx) [INOUT]
+!     d        : potential, (z,ky,kx)                             [OUT]
+!     dtop     : value of d at z=Lz, (ky,kx), normalized like a
+!                field in the (z,ky,kx) domain                    [IN]
+!
+      USE grid
+      USE var
+      USE kes
+      USE fft
+      USE commtypes
+      USE mpivars
+!$    USE threads
+
+      IMPLICIT NONE
+
+      COMPLEX(KIND=GP), INTENT(INOUT), DIMENSION(nz,ny,ista:iend) :: a,b,c
+      COMPLEX(KIND=GP), INTENT(OUT), DIMENSION(nz,ny,ista:iend)   :: d
+      COMPLEX(KIND=GP), INTENT(IN), DIMENSION(ny,ista:iend)       :: dtop
+
+      COMPLEX(KIND=GP), ALLOCATABLE, DIMENSION(:,:,:)             :: C1,C2,C3
+      COMPLEX(KIND=GP), DIMENSION(2,ny,ista:iend)                 :: bc
+
+      REAL(KIND=GP)    :: tmp
+      INTEGER          :: i,j,k
+
+      ALLOCATE( C1(nz,ny,ista:iend), C2(nz,ny,ista:iend), C3(nz,ny,ista:iend) )
+
+      ! Inhomogeneous solution, applied
+      CALL poisson_inhomogeneous(a,b,c,d)
+!$omp parallel do if (iend-ista.ge.nth) private (j,k)
+      DO i=ista,iend
+!$omp parallel do if (iend-ista.lt.nth) private (k)
+         DO j=1,ny
+            DO k=1,nz
+               a(k,j,i) = a(k,j,i) - im*kx(i)*d(k,j,i)
+               b(k,j,i) = b(k,j,i) - im*ky(j)*d(k,j,i)
+               c(k,j,i) = c(k,j,i) - im*kz(k)*d(k,j,i)
+            ENDDO
+         ENDDO
+      ENDDO
+
+      ! Residual normal velocity and inhomogeneous potential, in (z,ky,kx)
+      tmp = 1.0_GP/nz
+!$omp parallel do if (iend-ista.ge.nth) private (j,k)
+      DO i=ista,iend
+!$omp parallel do if (iend-ista.lt.nth) private (k)
+         DO j=1,ny
+            DO k=1,nz
+               C1(k,j,i) = c(k,j,i)*tmp
+               C2(k,j,i) = d(k,j,i)*tmp
+            ENDDO
+         ENDDO
+      ENDDO
+      CALL fftp1d_complex_to_real_z(planfc,C1,MPI_COMM_WORLD)
+      CALL fftp1d_complex_to_real_z(planfc,C2,MPI_COMM_WORLD)
+
+      ! Neumann datum at z=0 cancels the residual normal velocity there;
+      ! Dirichlet datum at z=Lz completes d_inh to the prescribed value.
+!$omp parallel do private (j)
+      DO i=ista,iend
+         DO j=1,ny
+            bc(1,j,i) = C1(1,j,i)
+            bc(2,j,i) = dtop(j,i) - C2(nz-Cz,j,i)
+         ENDDO
+      ENDDO
+
+      ! Harmonic part: C1 = d_hom, C3 = d(d_hom)/dz, both in (z,ky,kx)
+      CALL laplace_z(bc,C1,C3,1,0)
+
+      ! d = d_inh + d_hom in (z,ky,kx)
+!$omp parallel do if (iend-ista.ge.nth) private (j,k)
+      DO i=ista,iend
+!$omp parallel do if (iend-ista.lt.nth) private (k)
+         DO j=1,ny
+            DO k=1,nz
+               d(k,j,i) = C2(k,j,i) + C1(k,j,i)
+            ENDDO
+         ENDDO
+      ENDDO
+
+      ! Remove the harmonic contribution from the field
+      CALL fftp1d_real_to_complex_z(planfc,C1,MPI_COMM_WORLD)
+      CALL fftp1d_real_to_complex_z(planfc,C3,MPI_COMM_WORLD)
+!$omp parallel do if (iend-ista.ge.nth) private (j,k)
+      DO i=ista,iend
+!$omp parallel do if (iend-ista.lt.nth) private (k)
+         DO j=1,ny
+            DO k=1,nz
+               a(k,j,i) = a(k,j,i) - im*kx(i)*C1(k,j,i)
+               b(k,j,i) = b(k,j,i) - im*ky(j)*C1(k,j,i)
+               c(k,j,i) = c(k,j,i) - C3(k,j,i)
+            ENDDO
+         ENDDO
+      ENDDO
+
+      DEALLOCATE( C1,C2,C3 )
+
+      RETURN
+      END SUBROUTINE sol_project_fs
+
