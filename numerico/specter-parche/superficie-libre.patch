+      SUBROUTINE freeslip_z(planfc,vx,vy,vz,pos)
+!-----------------------------------------------------------------------
+!  Subroutine to apply free-slip (zero tangential stress) boundary
+!  conditions at the top or bottom boundary, i.e. a flat free surface.
+!
+!  DERIVATION. In the time-splitting scheme of Fontana et al., Comp.
+!  Phys. Comm. 256, 107482 (2020), each Runge-Kutta substage advances a
+!  pressureless velocity v* and then projects
+!
+!      v = v* - (dt/o) grad(p),
+!
+!  with the pressure obtained from a Neumann problem whose boundary datum
+!  is d(p)/dz = (o/dt) z.v* at the wall, which is what forces v_n = 0 after
+!  the projection (Eqs. 15, 16 and 30 of that reference).
+!
+!  Requiring zero tangential stress on the PROJECTED field, d(v_par)/dz = 0
+!  at the wall (the flat-surface condition, for which d(v_n)/dx and
+!  d(v_n)/dy vanish identically along the wall), and using the projection
+!  above together with the pressure boundary datum, gives a condition on
+!  v* that carries no dt at all:
+!
+!      d(v*_x)/dz = d(v*_z)/dx ,   d(v*_y)/dz = d(v*_z)/dy ,
+!
+!  i.e. in the (kx,ky,z) domain,
+!
+!      d(v*_x)/dz = i kx v*_z ,    d(v*_y)/dz = i ky v*_z .
+!
+!  This is the statement that the two tangential components of the
+!  vorticity vanish at the wall. Since the projection subtracts a gradient
+!  and the curl of a gradient is zero, curl(v*) = curl(v) exactly, so the
+!  condition is transferred to the projected field with no splitting error
+!  -- unlike the no-slip case, whose slip velocity is O(dt^ord).
+!
+!  The condition is a Neumann one, so it is imposed by reconstructing the
+!  boundary value from the normal derivative with the FC-Gram tables.
+!  Sign convention of neumann_reconstruct is the OUTWARD normal
+!  derivative, i.e. -d/dz at z=0 and +d/dz at z=Lz (see the comment
+!  "d/dz = -d/dn" in src/tests/fc_neumann.f90).
+!
+!  ARGUMENTS:
+!    planfc : FCPLAN to use during the imposition. [IN]
+!    vi     : Array containing the ith component of the velocity field in
+!             the (kx,ky,z) domain. [INOUT]
+!    pos    : 0 for bottom boundary, 1 for top boundary. [IN]
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+      USE kes
+      USE var
+!$    USE threads
+
+      IMPLICIT NONE
+
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(INOUT),DIMENSION(planfc%z%n,planfc%y%n,ista:iend) :: vx,vy
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(planfc%z%n,planfc%y%n,ista:iend)    :: vz
+      INTEGER, INTENT(IN)  :: pos
+
+      REAL(KIND=GP) :: sgn
+      INTEGER       :: ind
+      INTEGER       :: i,j
+
+      IF (pos .eq. 0) THEN
+         ind = 1
+         sgn = -1.0_GP
+      ELSEIF ( pos .eq. 1 ) THEN
+         ind = planfc%z%n - planfc%z%c
+         sgn = 1.0_GP
+      ENDIF
+
+ !$omp parallel do if (iend-ista.ge.nth) private (j)
+      DO i = ista,iend
+ !$omp parallel do if (iend-ista.lt.nth)
+         DO j = 1,planfc%y%n
+            vx(ind,j,i) = sgn*im*kx(i)*vz(ind,j,i)
+            vy(ind,j,i) = sgn*im*ky(j)*vz(ind,j,i)
+         ENDDO
+      ENDDO
+
+      CALL neumann_reconstruct(planfc,vx,5+pos,1)
+      CALL neumann_reconstruct(planfc,vy,5+pos,1)
+
+      END SUBROUTINE freeslip_z
+
