+!***********************************************************************
+      SUBROUTINE trace_z(planfc,f,bot,top)
+!-----------------------------------------------------------------------
+!  Values at z=0 and z=Lz of a field given in the (kz,ky,kx) domain,
+!  returned in the (ky,kx) domain with the normalization of the (z,ky,kx)
+!  domain (as goto_domain_w_boundaries leaves it). The field is not
+!  modified: a work copy is transformed.
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+
+      IMPLICIT NONE
+
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(planfc%z%n,planfc%y%n,ista:iend) :: f
+      COMPLEX(KIND=GP),INTENT(OUT),DIMENSION(planfc%y%n,ista:iend)           :: bot,top
+
+      COMPLEX(KIND=GP), ALLOCATABLE, DIMENSION(:,:,:) :: w
+      REAL(KIND=GP) :: tmp
+      INTEGER       :: ind,i,j
+
+      ALLOCATE( w(planfc%z%n,planfc%y%n,ista:iend) )
+      w = f
+      CALL fftp1d_complex_to_real_z(planfc,w,MPI_COMM_WORLD)
+      ind = planfc%z%n - planfc%z%c
+      tmp = 1.0_GP/real(planfc%z%n, kind=GP)
+      DO i = ista,iend
+         DO j = 1,planfc%y%n
+            bot(j,i) = w(1,j,i)*tmp
+            top(j,i) = w(ind,j,i)*tmp
+         ENDDO
+      ENDDO
+      DEALLOCATE( w )
+
+      RETURN
+      END SUBROUTINE trace_z
+
+!***********************************************************************
+      SUBROUTINE freesurface_imposebc(planbc,planfc,vx,vy,vz,pr,o,vbot)
+!-----------------------------------------------------------------------
+!  One Runge-Kutta substage with a deformable free surface at z=Lz,
+!  linearized: the conditions are applied at z=Lz, and the elevation
+!  eta(x,y,t) is a separate 2D field.
+!
+!      d(eta)/dt = w ,  du/dz + dw/dx = 0 ,  dv/dz + dw/dy = 0 ,
+!      p = g eta - (sigma/rho) lap_h(eta) + 2 nu dw/dz            at z=Lz,
+!
+!  with p the kinematic pressure minus the hydrostatic one of the fluid at
+!  rest, the same variable SPECTER integrates. Gravity is not a body force.
+!
+!  DERIVATION. Each substage o advances a pressureless v* and projects
+!  v = v* - grad(d), d = (dt/o) p (see noslip_z for the rescaling of pr).
+!
+!  (a) Pressure. The normal stress balance PRESCRIBES p at the surface, so
+!      d is Dirichlet at z=Lz, with datum (dt/o)[(g+sigma k^2/rho) eta +
+!      2 nu dw/dz], evaluated at the state of the previous substage like
+!      every other right-hand-side term of an explicit Runge-Kutta. The
+!      bottom keeps its Neumann datum (w=0 after projection). This is
+!      sol_project_fs, with the Neumann-Dirichlet branch of laplace_z.
+!
+!  (b) Elevation. eta^(o) = eta^n + (dt/o) w(Lz) of the previous substage,
+!      the same scheme as the velocity.
+!
+!  (c) Tangential stress. The stress is tau_x = du/dz + i kx w = omega_y +
+!      2 i kx w, where omega_y = du/dz - i kx w is the tangential vorticity,
+!      and the vorticity is not changed by the projection. Requiring
+!      tau_x = 0 on the PROJECTED field is then, on v*,
+!
+!          d(v*_x)/dz = i kx (v*_z - 2W) ,  d(v*_y)/dz = i ky (v*_z - 2W),
+!
+!      with W = w(Lz) AFTER the projection. With W = 0 this is freeslip_z.
+!      W is not known in advance, but the whole chain (Neumann
+!      reconstruction, FC-Gram continuation, projection) is linear and
+!      decoupled in the horizontal modes, so that W_final = A_k + B_k W for
+!      each mode, with B_k fixed for the run (computed in v_fs_init). One
+!      pass with a trial W gives A_k, W = A_k/(1-B_k) is then exact, and a
+!      second pass imposes it. fscoup=1 does a single pass with the W of
+!      the previous substage, an O(dt) stress error kept only as the
+!      negative control of the acceptance gate.
+!
+!  (d) v*_z stays in the (kz,ky,kx) domain; only its traces are read. The
+!      flat path used to send it through goto_domain_w_boundaries and back
+!      (fixed there too on 2026-09-28), which
+!      recomputes its FC continuation from the physical values. After a
+!      projection those do not match exactly, so each substage changes the
+!      field by an amount that does NOT vanish with dt: an error proportional
+!      to the number of steps (measured with the acceptance gate: observed
+!      time order 1.45 instead of 2, and an energy change per step
+!      independent of dt as dt -> 0). Without the round trip the order is
+!      2.00 and the drift is gone.
+!
+!  ARGUMENTS:
+!    planbc : BCPLAN to use during the imposition. [IN]
+!    planfc : FCPLAN to use during the imposition. [IN]
+!    vi     : ith component of the velocity field, (kz,ky,kx). [INOUT]
+!    pr     : pressure potential d, (z,ky,kx). [INOUT]
+!    o      : current iteration of the Runge-Kutta scheme. [IN]
+!    vbot   : tangential velocity of the bottom wall. [IN]
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+      USE kes
+      USE var
+      USE order
+!$    USE threads
+
+      IMPLICIT NONE
+
+      TYPE(BCPLAN), INTENT(IN)  :: planbc
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(INOUT),DIMENSION(planfc%z%n,planfc%y%n,ista:iend) :: vx,vy,vz,pr
+      INTEGER, INTENT(IN)       :: o
+      REAL(KIND=GP), INTENT(IN), DIMENSION(2) :: vbot
+
+      COMPLEX(KIND=GP), DIMENSION(planfc%y%n,ista:iend) :: dtop,wg,wn,wst,wsb
+      REAL(KIND=GP) :: fac
+      REAL(KIND=GP), DIMENSION(2) :: loc,glo
+      INTEGER       :: i,j
+
+      IF ( .NOT. fs_ready ) THEN
+         IF ( myrank .eq. 0 ) PRINT*, "[ERROR] freesurface used before ", &
+             "v_fs_init. Aborting..."
+         CALL MPI_ABORT(MPI_COMM_WORLD,1,ierr)
+      ENDIF
+
+      fac = fs_dt/real(o, kind=GP)
+      IF ( o .eq. ord ) fs_eta0 = fs_eta
+
+      ! (a) and (b), both from the state of the previous substage
+      DO i = ista,iend
+         DO j = 1,planfc%y%n
+            dtop(j,i) = fac*( (fs_grav + fs_tens*khom(j,i)**2)*fs_eta(j,i) + &
+                              2*fs_nu*fs_dwz(j,i) )
+            fs_eta(j,i) = fs_eta0(j,i) + fac*fs_wtop(j,i)
+         ENDDO
+      ENDDO
+
+      ! v*_z is only read at the faces, through its traces (item d)
+      CALL fs_trace(planfc,vz,wst)
+      IF ( planbc%bczsta .ne. 0 ) CALL fs_trace_bottom(planfc,vz,wsb)
+
+      ! Bottom, as in the flat paths
+      CALL goto_domain_w_boundaries(planbc,planfc,vx,vy)
+      IF ( planbc%bczsta .eq. 0 ) THEN
+         CALL noslip_z(planfc,o,vx,vy,vz,pr,vbot,0)
+      ELSE
+         CALL freeslip_z(planfc,vx,vy,wsb,0)
+      ENDIF
+
+      ! (c) Surface
+      wg = fs_wtop
+      IF ( fs_coup .eq. 2 ) THEN
+         fs_s1 = vx; fs_s2 = vy; fs_s3 = vz
+      ENDIF
+      CALL fs_top_pass(planbc,planfc,vx,vy,vz,pr,dtop,wst,wg)
+      CALL fs_trace(planfc,vz,wn)
+      IF ( fs_coup .eq. 2 ) THEN
+         wg = (wn - fs_bk*wg)/(1.0_GP - fs_bk)
+         vx = fs_s1; vy = fs_s2; vz = fs_s3
+         CALL fs_top_pass(planbc,planfc,vx,vy,vz,pr,dtop,wst,wg)
+         CALL fs_trace(planfc,vz,wn)
+      ENDIF
+
+      ! Relative mismatch between the surface velocity used in the stress
+      ! datum and the one obtained (roundoff for fscoup=2, O(dt) for 1)
+      loc(1) = maxval(abs(wn-wg))
+      loc(2) = maxval(abs(wn))
+      CALL MPI_ALLREDUCE(loc,glo,2,GC_REAL,MPI_MAX,MPI_COMM_WORLD,ierr)
+      fs_mismatch = glo(1)/max(glo(2),tiny(1.0_GP))
+
+      ! Traces for the next substage
+      fs_wtop = wn
+      CALL fs_dwz_trace(planfc,vx,vy,fs_dwz)
+
+      RETURN
+      END SUBROUTINE freesurface_imposebc
+
+!***********************************************************************
+      SUBROUTINE fs_top_pass(planbc,planfc,vx,vy,vz,d,dtop,wstar,wsurf)
+!-----------------------------------------------------------------------
+!  Imposes the tangential stress datum at z=Lz for a given surface
+!  velocity wsurf, goes back to 3D Fourier and projects with sol_project_fs.
+!  vx,vy enter in the (z,ky,kx) domain and leave in (kz,ky,kx); vz is in
+!  (kz,ky,kx) throughout, and wstar is its value at z=Lz. d is the
+!  resulting potential in (z,ky,kx). The sign convention of
+!  neumann_reconstruct is the outward normal derivative, +d/dz at z=Lz.
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+      USE kes
+      USE var
+!$    USE threads
+
+      IMPLICIT NONE
+
+      TYPE(BCPLAN), INTENT(IN)  :: planbc
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(INOUT),DIMENSION(planfc%z%n,planfc%y%n,ista:iend) :: vx,vy,vz
+      COMPLEX(KIND=GP),INTENT(OUT),DIMENSION(planfc%z%n,planfc%y%n,ista:iend)   :: d
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(planfc%y%n,ista:iend) :: dtop,wsurf
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(planfc%y%n,ista:iend) :: wstar
+
+      INTEGER :: ind,i,j
+
+      ind = planfc%z%n - planfc%z%c
+!$omp parallel do if (iend-ista.ge.nth) private (j)
+      DO i = ista,iend
+!$omp parallel do if (iend-ista.lt.nth)
+         DO j = 1,planfc%y%n
+            vx(ind,j,i) = im*kx(i)*(wstar(j,i) - 2*wsurf(j,i))
+            vy(ind,j,i) = im*ky(j)*(wstar(j,i) - 2*wsurf(j,i))
+         ENDDO
+      ENDDO
+      CALL neumann_reconstruct(planfc,vx,6,1)
+      CALL neumann_reconstruct(planfc,vy,6,1)
+
+      CALL goto_3d_fourier(planbc,planfc,vx,vy)
+      CALL sol_project_fs(vx,vy,vz,d,dtop)
+
+      RETURN
+      END SUBROUTINE fs_top_pass
+
+!***********************************************************************
+      SUBROUTINE fs_trace(planfc,f,t)
+!-----------------------------------------------------------------------
+!  Value at z=Lz of a field given in the (kz,ky,kx) domain, returned in
+!  the (ky,kx) domain with the normalization of the (z,ky,kx) domain.
+!-----------------------------------------------------------------------
+      USE fprecision
+      USE mpivars
+      USE commtypes
+      USE fcgram
+
+      IMPLICIT NONE
+
+      TYPE(FCPLAN), INTENT(IN)  :: planfc
+      COMPLEX(KIND=GP),INTENT(IN),DIMENSION(planfc%z%n,planfc%y%n,ista:iend) :: f
+      COMPLEX(KIND=GP),INTENT(OUT),DIMENSION(planfc%y%n,ista:iend)           :: t
+
+      INTEGER :: ind,i,j
+
+      fs_work = f
+      CALL fftp1d_complex_to_real_z(planfc,fs_work,MPI_COMM_WORLD)
+      ind = planfc%z%n - planfc%z%c
+      DO i = ista,iend
+         DO j = 1,planfc%y%n
+            t(j,i) = fs_work(ind,j,i)/real(planfc%z%n, kind=GP)
+         ENDDO
+      ENDDO
+
+      RETURN
+      END SUBROUTINE fs_trace
